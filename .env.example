# ============================================
# Firdavs VIP Bot — Environment Variables
# ============================================

# Telegram
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
ADMIN_ID=123456789
ADMIN_USERNAME=firdavs

# Database
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Security
ADMIN_PIN=2026
ANTIFLOOD_RATE=2
ANTIFLOOD_BURST=5
SPAM_KEYWORDS=viagra,casino,crypto giveaway,free money,click here,xxx,sex

# Bot
DEFAULT_LANGUAGE=uz
AUTO_REPLY_ENABLED=true
AUTO_REPLY_TEXT=✅ Xabaringiz qabul qilindi! Admin tez orada javob beradi. 🤍

# Limits
MAX_MESSAGE_LENGTH=4000
MAX_HISTORY_PER_USER=50

# Branding
BRAND_NAME=Firdavs VIP
BRAND_TAGLINE=Premium anonymous chat — siz bilan, faqat siz uchun 🤍
BRAND_URL=https://t.me/FirdavsVipBot

# Misc
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent
